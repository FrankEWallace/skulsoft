# ============================================
# SkulSoft Production Environment Template
# ============================================
# Copy this to .env and fill in your production values
# Never commit this file with real credentials!
# ============================================

# Application
APP_NAME="SkulSoft School Management"
APP_ENV=production
APP_KEY=                                # Generate with: php artisan key:generate
APP_DEBUG=false                         # MUST be false in production
APP_URL=https://yourschool.com          # Your production domain

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                         # error, warning, info, debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skulsoft_production         # Change to your database name
DB_USERNAME=skulsoft_user               # Change to your database user
DB_PASSWORD=                            # Strong password here (min 16 chars)

# Cache & Session
CACHE_DRIVER=redis                      # redis recommended for production
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis                  # redis recommended for production
SESSION_DRIVER=redis                    # redis recommended for production
SESSION_LIFETIME=120

# Redis (Recommended for Production)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io             # Change to your SMTP server
MAIL_PORT=587
MAIL_USERNAME=                          # Your SMTP username
MAIL_PASSWORD=                          # Your SMTP password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourschool.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (Optional - for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher (Real-time Broadcasting)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Payment Gateway - Razorpay
RAZORPAY_KEY_ID=                        # Your Razorpay key
RAZORPAY_KEY_SECRET=                    # Your Razorpay secret
RAZORPAY_WEBHOOK_SECRET=                # Your webhook secret

# Payment Gateway - BillDesk
BILLDESK_MERCHANT_ID=
BILLDESK_SECURITY_ID=
BILLDESK_CHECKSUM_KEY=

# SMS Configuration
SMS_DRIVER=twilio                       # twilio, nexmo, etc.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Services (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Backup Configuration
BACKUP_ARCHIVE_PASSWORD=                # Password for encrypted backups

# Security
SESSION_SECURE_COOKIE=true              # MUST be true with HTTPS
SANCTUM_STATEFUL_DOMAINS=yourschool.com # Your production domain

# Performance
TELESCOPE_ENABLED=false                 # Disable in production
DEBUGBAR_ENABLED=false                  # Disable in production
HORIZON_ENABLED=true                    # Enable for queue monitoring

# Application Specific
SCHOOL_NAME="Your School Name"
SCHOOL_CODE="SCH001"
SCHOOL_TIMEZONE="America/New_York"      # Your timezone
SCHOOL_LOCALE="en"
SCHOOL_CURRENCY="USD"

# Limits
MAX_UPLOAD_SIZE=10240                   # KB (10MB)
SESSION_TIMEOUT=120                     # minutes
LOGIN_THROTTLE_ATTEMPTS=5
LOGIN_THROTTLE_DECAY=2                  # minutes

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_API=true
ENABLE_TWO_FACTOR=false
ENABLE_EMAIL_VERIFICATION=true

# ============================================
# IMPORTANT PRODUCTION NOTES:
# ============================================
# 1. Generate APP_KEY with: php artisan key:generate
# 2. Set strong database password (16+ characters)
# 3. Configure proper mail server (not mailtrap)
# 4. Enable Redis for better performance
# 5. Set SESSION_SECURE_COOKIE=true
# 6. Configure SSL certificate
# 7. Set proper file permissions: chmod 600 .env
# 8. Never commit .env to version control
# 9. Use environment-specific backups
# 10. Test all configurations before going live
# ============================================
